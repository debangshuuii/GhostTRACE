datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Workspace {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  environment String     @default("production") // production, staging, development
  createdAt   DateTime   @default(now())
  traces      TraceRun[]
  apiKeys     ApiKey[]
  alerts      WebhookAlertConfig[]
  members     WorkspaceMember[]
}

model TraceRun {
  id               String            @id @default(cuid())
  workspaceId      String?
  title            String
  agentName        String
  model            String
  status           String            @default("COMPLETED") // COMPLETED, FAILED, RUNNING, PRUNED, PAUSED
  isPaused         Boolean           @default(false)
  pausedStep       Int?
  totalTokens      Int               @default(0)
  promptTokens     Int               @default(0)
  completionTokens Int               @default(0)
  reasoningTokens  Int               @default(0)
  costEstimate     Float             @default(0.0)
  durationMs       Int               @default(0)
  ghostBranchCount Int               @default(0)
  sessionId        String?
  turnIndex        Int               @default(1)
  parentTraceId    String?
  tags             String            @default("[]") // JSON stringified string[]
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  workspace        Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  nodes            TraceNode[]
  edges            TraceEdge[]
  evaluations      TraceEvaluation[]

  @@index([workspaceId])
  @@index([sessionId])
}

model TraceNode {
  id                  String    @id @default(cuid())
  traceRunId          String
  nodeId              String
  stepIndex           Int
  type                String    // USER_PROMPT, THINKING, TOOL_CALL, TOOL_RESULT, LLM_RESPONSE, GHOST_REJECTED, SUBAGENT_SPAWN, ERROR
  label               String
  role                String?
  content             String
  rawInput            String?
  rawOutput           String?
  latencyMs           Int?      @default(0)
  tokens              Int?      @default(0)
  cost                Float?    @default(0.0)
  status              String    @default("SUCCESS") // SUCCESS, FAILED, PRUNED, ROLLED_BACK, PAUSED
  isGhost             Boolean   @default(false)
  ghostReason         String?
  confidenceScore     Float?
  positionX           Float     @default(0)
  positionY           Float     @default(0)
  interventionInput   String?   // Operator override content
  interventionVerdict String?   // RESUMED, OVERRIDDEN, VETOED
  createdAt           DateTime  @default(now())
  traceRun            TraceRun  @relation(fields: [traceRunId], references: [id], onDelete: Cascade)

  @@index([traceRunId])
}

model TraceEdge {
  id         String   @id @default(cuid())
  traceRunId String
  edgeId     String
  source     String
  target     String
  type       String   @default("DEFAULT") // DEFAULT, BRANCH, GHOST_PRUNED, FALLBACK, SUBAGENT
  label      String?
  isGhost    Boolean  @default(false)
  traceRun   TraceRun @relation(fields: [traceRunId], references: [id], onDelete: Cascade)

  @@index([traceRunId])
}

model TraceEvaluation {
  id         String   @id @default(cuid())
  traceRunId String
  evaluator  String   @default("Human")
  rating     Int      @default(5)
  verdict    String   @default("OPTIMAL") // OPTIMAL, SUBOPTIMAL, FAILED, HALLUCINATION_DETECTED
  feedback   String
  createdAt  DateTime @default(now())
  traceRun   TraceRun @relation(fields: [traceRunId], references: [id], onDelete: Cascade)

  @@index([traceRunId])
}

model ApiKey {
  id          String     @id @default(cuid())
  workspaceId String?
  name        String
  keyPreview  String     // e.g. gt_live_...38f1
  keySecret   String     @unique
  environment String     @default("production") // production, staging, development
  status      String     @default("ACTIVE")     // ACTIVE, REVOKED
  lastUsedAt  DateTime?
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

model WebhookAlertConfig {
  id               String   @id @default(cuid())
  workspaceId      String?
  name             String   @default("Slack / Discord Alerts")
  url              String
  type             String   @default("SLACK") // SLACK, DISCORD, GENERIC
  enabled          Boolean  @default(true)
  alertOnGuardrail Boolean  @default(true)
  alertOnSwarmLoop Boolean  @default(true)
  alertOnTokenSpike Boolean @default(true)
  alertOnError     Boolean  @default(true)
  minSeverity      String   @default("HIGH") // CRITICAL, HIGH, MEDIUM, LOW
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  workspace        Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String            @unique
  emailVerified DateTime?
  image         String?
  globalRole    String            @default("MEMBER") // SUPER_ADMIN, ADMIN, MEMBER
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  memberships   WorkspaceMember[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String   // github, google
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("DEVELOPER") // OWNER, ADMIN, DEVELOPER, VIEWER
  invitedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

